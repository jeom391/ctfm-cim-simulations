new file mode 100644
index 0000000..af78294
--- /dev/null
+++ b/Inference_pytorch/NeuroSIM/Ctfm.h
@@ -0,0 +1,30 @@
+#ifndef CTFM_H_
+#define CTFM_H_
+// CTFM instrumentation: per-layer block ledger for the two-plane cost model (see engine-patches/neurosim/README.md).
+#include <vector>
+
+struct CtfmLayer {
+	double plane[2][4];   // [0]=G+ plane, [1]=G- plane; {WL cap energy, MLSA+encoder, drivers/mux, shift-add/accumulate} summed over subarray-cycles (J)
+	double eSub;          // digital subtractor energy (adc_then_subtract) (J)
+	double eArray;        // cell read energy is inside the MLSA model (column current); kept for completeness
+	double cycles;        // subarray-cycles accumulated
+	double usedSub, instSub;   // subarrays holding weights / subarray slots of the visited PEs (per plane)
+	double activeRows, totalRows;   // sum over subarray-cycles of rows read / rows
+	double colDelayMax, senseLatencyMax;
+	double subLatency;
+	double colG[2];        // sum over subarray-cycles and columns of the column conductance the engine derived from the G files (S)
+	double weightCells;    // weight cells (one per weight, per plane) inside the used subarrays
+	CtfmLayer() {
+		colG[0] = colG[1] = 0; weightCells = 0;
+		for (int p = 0; p < 2; p++) for (int b = 0; b < 4; b++) plane[p][b] = 0;
+		eSub = eArray = cycles = usedSub = instSub = activeRows = totalRows = colDelayMax = senseLatencyMax = subLatency = 0;
+	}
+};
+
+extern std::vector<CtfmLayer> gCtfmLedger;
+extern int gCtfmLayer;
+extern double gCtfmClkPeriod;
+CtfmLayer& CtfmLedgerAt(int layer);
+void CtfmLedgerPrint();
+
+#endif
