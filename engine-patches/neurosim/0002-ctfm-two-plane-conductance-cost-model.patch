+// CTFM patch 0002. Area of the read datapath of one subarray slot.
+//   read-only: write-only circuits (SL switch matrix, level shifters) are not built
+//   differential: two arrays with their own row drivers/muxes; MLSA once per plane for adc_then_subtract, not costed for
+//   subtract_then_adc (a signed front end is not the unsigned MLSA of this engine); shift-add/accumulate once; subtractor.
+// The layout overhead (box area over module area) of the reference layout is kept.
+void SubArray::CtfmAdjustArea(double widthArray) {
+	if (!param->ctfmReadOnly && !param->ctfmDifferential) return;
+	double sllevel = (cell.writeVoltage > 1.5) ? (wllevelshifter.area + bllevelshifter.area + sllevelshifter.area) : 0;
+	double writeOnly = slSwitchMatrix.area + sllevel;
+	double readPath = areaOther - writeOnly;            // wl switch matrices, mux, mux decoder, repeaters
+	double adc = areaADC, accum = areaAccum, arr = areaArray;
+	double ratio = usedArea > 0 ? area/usedArea : 1;
+	double planes = param->ctfmDifferential ? 2 : 1;
+	double adcFactor = param->ctfmDifferential ? (param->ctfmAdcOrder == 1 ? 2 : 0) : 1;
+	double subArea = 0;
+	if (param->ctfmDifferential && param->ctfmAdcOrder == 1) {
+		ctfmSub.CalculateArea(0, widthArray, NONE);
+		subArea = ctfmSub.area;
+	}
+	double writeKept = param->ctfmReadOnly ? 0 : writeOnly;
+	areaArray = planes*arr;
+	areaADC = adcFactor*adc;
+	areaAccum = accum + subArea;
+	areaOther = planes*(readPath + writeKept);
+	double newUsed = areaArray + areaADC + areaAccum + areaOther;
+	usedArea = newUsed;
+	area = newUsed*ratio;
+	emptyArea = area - usedArea;
+}
