+#include <cstdio>
+#include <iostream>
+#include "Ctfm.h"
+#include "Param.h"
+#include "SubArray.h"
+
+extern SubArray *subArrayInPE;
+
+extern Param *param;
+
+std::vector<CtfmLayer> gCtfmLedger;
+int gCtfmLayer = 0;
+double gCtfmClkPeriod = 0;
+
+CtfmLayer& CtfmLedgerAt(int layer) {
+	if (layer < 0) layer = 0;
+	while ((int) gCtfmLedger.size() <= layer) gCtfmLedger.push_back(CtfmLayer());
+	return gCtfmLedger[layer];
+}
+
+void CtfmLedgerPrint() {
+	if (!(param->ctfmConductanceInput || param->ctfmDifferential || param->ctfmNoDuplication || param->ctfmReadOnly || param->ctfmUsedOnly)) return;   // reference builds print exactly what they printed before
+	printf("CTFM_LEDGER_BEGIN\n");
+	printf("CTFM_FLAGS conductance_input=%d differential=%d adc_order=%d no_duplication=%d read_only=%d used_only=%d\n",
+		param->ctfmConductanceInput, param->ctfmDifferential, param->ctfmAdcOrder, param->ctfmNoDuplication, param->ctfmReadOnly, param->ctfmUsedOnly);
+	printf("CTFM_CLK period_s=%.9e\n", gCtfmClkPeriod);
+	printf("CTFM_PARAMS read_voltage_v=%.9e resistance_on_ohm=%.9e resistance_off_ohm=%.9e resistance_access_ohm=%.9e "
+		"wire_res_row_ohm=%.9e wire_res_col_ohm=%.9e sub_rows=%d sub_cols=%d cols_muxed=%d level_output=%d technode_nm=%d "
+		"read_pulse_width_s=%.9e write_voltage_v=%.9e num_bit_input=%d parallel_read=%d num_row_parallel=%d\n",
+		param->readVoltage, param->resistanceOn, param->resistanceOff, param->resistanceAccess, param->wireResistanceRow, param->wireResistanceCol,
+		param->numRowSubArray, param->numColSubArray, param->numColMuxed, param->levelOutput, param->technode, param->readPulseWidth,
+		param->writeVoltage, param->numBitInput, param->parallelRead, param->numRowParallel);
+	// one subarray slot as the engine sized it (after the read-only / two-plane adjustment); the digital subtractor is inside "accum"
+	printf("CTFM_SLOT area_m2=%.9e array_m2=%.9e adc_m2=%.9e accum_m2=%.9e other_m2=%.9e subtractor_m2=%.9e\n",
+		subArrayInPE->area, subArrayInPE->areaArray, subArrayInPE->areaADC, subArrayInPE->areaAccum, subArrayInPE->areaOther,
+		(param->ctfmDifferential && param->ctfmAdcOrder == 1) ? subArrayInPE->ctfmSub.area : 0.0);
+	for (int l = 0; l < (int) gCtfmLedger.size(); l++) {
+		const CtfmLayer& c = gCtfmLedger[l];
+		printf("CTFM_LAYER l=%d cycles=%.0f used_subarrays=%.0f instantiated_subarrays=%.0f active_rows=%.0f total_rows=%.0f "
+			"plus_wlcap_j=%.9e plus_mlsa_j=%.9e plus_drivers_j=%.9e plus_accum_j=%.9e "
+			"minus_wlcap_j=%.9e minus_mlsa_j=%.9e minus_drivers_j=%.9e minus_accum_j=%.9e "
+			"sub_j=%.9e col_delay_max_s=%.9e sense_latency_max_s=%.9e sub_latency_s=%.9e plus_colg_s=%.9e minus_colg_s=%.9e weight_cells=%.0f\n",
+			l, c.cycles, c.usedSub, c.instSub, c.activeRows, c.totalRows,
+			c.plane[0][0], c.plane[0][1], c.plane[0][2], c.plane[0][3],
+			c.plane[1][0], c.plane[1][1], c.plane[1][2], c.plane[1][3],
+			c.eSub, c.colDelayMax, c.senseLatencyMax, c.subLatency, c.colG[0], c.colG[1], c.weightCells);
+	}
+	printf("CTFM_LEDGER_END\n");
+}
