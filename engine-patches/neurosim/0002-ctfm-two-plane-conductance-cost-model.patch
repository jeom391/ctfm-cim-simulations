index 6ac720a..3fa332b 100644
--- a/Inference_pytorch/NeuroSIM/ProcessingUnit.cpp
+++ b/Inference_pytorch/NeuroSIM/ProcessingUnit.cpp
@@ -50,6 +50,108 @@
 #include "ProcessingUnit.h"
 #include "Param.h"
 #include "AdderTree.h"
+#include "Ctfm.h"
+
+extern Param *param;
+
+// CTFM patch 0002: one subarray, one input-bit cycle, for both physical planes.
+// SubArray keeps its results in its own members, so plane values are captured after each plane's call and the
+// combined result is written back for the unchanged accumulation code that follows.
+struct CtfmCap {
+	double readLatency, readLatencyADC, readLatencyAccum, readLatencyOther;
+	double energyArray, energyMlsa, energyOther, energyAccum;
+	double leakage, leakAdc, leakAccum, colDelay, senseLatency;
+};
+
+static void CtfmCapture(SubArray *s, bool clkPass, CtfmCap *c) {
+	c->readLatency = s->readLatency; c->readLatencyADC = s->readLatencyADC;
+	c->readLatencyAccum = s->readLatencyAccum; c->readLatencyOther = s->readLatencyOther;
+	c->colDelay = s->colDelay;
+	c->senseLatency = s->multilevelSenseAmp.readLatency + s->multilevelSAEncoder.readLatency + s->sarADC.readLatency;
+	c->energyArray = c->energyMlsa = c->energyOther = c->energyAccum = 0;
+	c->leakage = c->leakAdc = c->leakAccum = 0;
+	if (!clkPass) {
+		c->energyArray = s->readDynamicEnergyArray;   // word-line capacitance switching
+		// column read path: the MLSA power model is a fit against the column resistance, so cell read power and sensing are one block
+		c->energyMlsa = s->multilevelSenseAmp.readDynamicEnergy + s->multilevelSAEncoder.readDynamicEnergy + s->sarADC.readDynamicEnergy;
+		c->energyOther = s->wlNewSwitchMatrix.readDynamicEnergy + s->wlSwitchMatrix.readDynamicEnergy
+			+ (s->numColMuxed > 1 ? (s->mux.readDynamicEnergy + s->muxDecoder.readDynamicEnergy) : 0);
+		c->energyAccum = s->shiftAddWeight.readDynamicEnergy + s->shiftAddInput.readDynamicEnergy + s->adder.readDynamicEnergy + s->dff.readDynamicEnergy;
+		c->leakage = s->leakage;
+		c->leakAdc = s->multilevelSenseAmp.leakage + s->multilevelSAEncoder.leakage;
+		c->leakAccum = s->shiftAddWeight.leakage + s->shiftAddInput.leakage + s->dff.leakage + s->adder.leakage;
+	}
+}
+
+static void CtfmLedgerAdd(int plane, const CtfmCap& c) {
+	CtfmLayer& l = CtfmLedgerAt(gCtfmLayer);
+	l.plane[plane][0] += c.energyArray; l.plane[plane][1] += c.energyMlsa;
+	l.plane[plane][2] += c.energyOther; l.plane[plane][3] += c.energyAccum;
+	if (c.colDelay > l.colDelayMax) l.colDelayMax = c.colDelay;
+	if (c.senseLatency > l.senseLatencyMax) l.senseLatencyMax = c.senseLatency;
+}
+
+// reference (single-plane) path: only records what the engine computed
+static double CtfmSumG(const vector<double>& res) {
+	double g = 0;
+	for (size_t i = 0; i < res.size(); i++) g += 1.0/res[i];
+	return g;
+}
+
+static void CtfmRecordSingle(SubArray *s, double numRowRead, const vector<double>& res) {
+	CtfmCap c;
+	CtfmCapture(s, false, &c);
+	CtfmLedgerAdd(0, c);
+	CtfmLayer& l = CtfmLedgerAt(gCtfmLayer);
+	l.colG[0] += CtfmSumG(res);
+	l.cycles += 1; l.activeRows += numRowRead; l.totalRows += s->numRow;
+}
+
+static void CtfmDifferentialStep(SubArray *s, const vector<double>& resPlus, const vector<double>& resMinus, bool clkPass, double numRowRead) {
+	CtfmCap p, n;
+	s->CalculateLatency(1e20, resPlus, clkPass);
+	if (!clkPass) s->CalculatePower(resPlus);
+	CtfmCapture(s, clkPass, &p);
+	s->CalculateLatency(1e20, resMinus, clkPass);
+	if (!clkPass) s->CalculatePower(resMinus);
+	CtfmCapture(s, clkPass, &n);
+	if (clkPass) {
+		// both planes are sensed at the same time: the clock has to fit the slower one
+		s->readLatency = p.readLatency > n.readLatency ? p.readLatency : n.readLatency;
+		return;
+	}
+	bool ats = (param->ctfmAdcOrder == 1);
+	// the sensing-cycle counts are structural (columns per converter x reads) and equal for both planes
+	s->readLatencyADC = p.readLatencyADC > n.readLatencyADC ? p.readLatencyADC : n.readLatencyADC;
+	s->readLatencyOther = p.readLatencyOther > n.readLatencyOther ? p.readLatencyOther : n.readLatencyOther;
+	s->readLatencyAccum = p.readLatencyAccum;
+	double subE = 0, subLeak = 0, subLat = 0;
+	if (ats) {
+		// digital subtraction after the two converters, pipelined like the engine's own adder (only cycles beyond the first are exposed)
+		s->ctfmSub.CalculateLatency(1e20, s->dff.capTgDrain, 1);
+		s->ctfmSub.CalculatePower(s->numColMuxed, (int) ceil((double) s->numCol/(double) s->numColMuxed));
+		subE = s->ctfmSub.readDynamicEnergy;
+		subLeak = s->ctfmSub.leakage;
+		double extra = s->numColMuxed*(ceil(s->ctfmSub.readLatency*s->clkFreq) - 1);
+		if (extra > 0) { s->readLatencyAccum += extra; subLat = extra; }
+	}
+	s->readLatency = s->readLatencyADC + s->readLatencyAccum + s->readLatencyOther;
+	double array = p.energyArray + n.energyArray;
+	double adc = ats ? (p.energyMlsa + n.energyMlsa) : 0;   // subtract_then_adc: signed column sensing is not the unsigned MLSA of this engine
+	double other = p.energyOther + n.energyOther;
+	double accum = p.energyAccum + subE;                     // shift-add / accumulate once, after the subtraction
+	s->readDynamicEnergyArray = array;
+	s->readDynamicEnergyADC = array + adc;
+	s->readDynamicEnergyAccum = accum;
+	s->readDynamicEnergyOther = other;
+	s->readDynamicEnergy = array + adc + other + accum;
+	s->leakage = p.leakage + n.leakage - n.leakAccum - (ats ? 0 : (p.leakAdc + n.leakAdc)) + subLeak;
+	CtfmLedgerAdd(0, p);
+	CtfmLedgerAdd(1, n);
+	CtfmLayer& l = CtfmLedgerAt(gCtfmLayer);
+	l.colG[0] += CtfmSumG(resPlus); l.colG[1] += CtfmSumG(resMinus);
+	l.eSub += subE; l.cycles += 1; l.activeRows += numRowRead; l.totalRows += s->numRow; l.subLatency += subLat;
+}
