{
  "$defs": {
    "AnalysisInput": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "enum": [
                "program",
                "erase"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "column_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Column Mapping",
          "type": "object"
        },
        "condition_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "ltp",
                "ltd"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "header_read_vgs_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Header Read Vgs V"
        },
        "measurement_conditions": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measurement Conditions"
        },
        "read_vgs_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Vgs V"
        },
        "row_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row End"
        },
        "row_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Start"
        },
        "selection": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "iv_block": "#/$defs/IvBlockSelection",
                  "retention_columns": "#/$defs/RetentionColumnSelection"
                },
                "propertyName": "type"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/IvBlockSelection"
                },
                {
                  "$ref": "#/$defs/RetentionColumnSelection"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        },
        "start_time_s": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Time S"
        },
        "sweep_amplitude_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep Amplitude V"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "vds_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vds V"
        }
      },
      "required": [
        "file_id",
        "device_id",
        "condition_id"
      ],
      "title": "AnalysisInput",
      "type": "object"
    },
    "IvBlockSelection": {
      "additionalProperties": false,
      "description": "Explicit Vg/Id/Ig block and monotone Vg segment of a repeated-block IV sheet.",
      "properties": {
        "block": {
          "minimum": 0,
          "title": "Block",
          "type": "integer"
        },
        "segment": {
          "minimum": 0,
          "title": "Segment",
          "type": "integer"
        },
        "type": {
          "const": "iv_block",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "block",
        "segment"
      ],
      "title": "IvBlockSelection",
      "type": "object"
    },
    "RetentionColumnSelection": {
      "additionalProperties": false,
      "description": "Explicit 0-based sheet columns for the independent Erase/Program time axes.",
      "properties": {
        "columns": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Columns",
          "type": "object"
        },
        "type": {
          "const": "retention_columns",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "columns"
      ],
      "title": "RetentionColumnSelection",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "items": {
        "$ref": "#/$defs/AnalysisInput"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "kind": {
      "enum": [
        "iv",
        "d2d",
        "retention",
        "pulse_states",
        "c2c_detrended",
        "c2c_sweep"
      ],
      "title": "Kind",
      "type": "string"
    },
    "recognition_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Recognition Id"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "inputs"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
