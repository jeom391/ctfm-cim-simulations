{
  "$defs": {
    "AnalysisInput": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "enum": [
                "program",
                "erase"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "column_mapping": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Column Mapping",
          "type": "object"
        },
        "condition_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "device_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Device Id",
          "type": "string"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "ltp",
                "ltd"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "read_vgs_v": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Read Vgs V"
        },
        "row_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row End"
        },
        "row_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Start"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        },
        "sweep_amplitude_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep Amplitude V"
        },
        "units": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Units",
          "type": "object"
        },
        "vds_v": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vds V"
        }
      },
      "required": [
        "file_id",
        "column_mapping",
        "units",
        "device_id",
        "condition_id"
      ],
      "title": "AnalysisInput",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "items": {
        "$ref": "#/$defs/AnalysisInput"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "kind": {
      "enum": [
        "iv",
        "d2d",
        "retention",
        "pulse_states"
      ],
      "title": "Kind",
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "title": "Settings",
      "type": "object"
    }
  },
  "required": [
    "kind",
    "inputs"
  ],
  "title": "AnalysisRequest",
  "type": "object"
}
