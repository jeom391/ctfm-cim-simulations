{
  "$defs": {
    "ComparisonCardResult": {
      "additionalProperties": false,
      "properties": {
        "base_profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonProfileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "c2c_analysis_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "C2C Analysis Id"
        },
        "c2c_approved_assumption": {
          "default": false,
          "title": "C2C Approved Assumption",
          "type": "boolean"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Ids",
          "type": "array"
        },
        "card_id": {
          "format": "uuid",
          "title": "Card Id",
          "type": "string"
        },
        "condition_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition Id"
        },
        "cross_condition_acknowledged": {
          "default": false,
          "title": "Cross Condition Acknowledged",
          "type": "boolean"
        },
        "d2d_analysis_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "D2D Analysis Id"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "experiment_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "job_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "manual_c2c_cv_percent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual C2C Cv Percent"
        },
        "manual_d2d_cv_percent": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual D2D Cv Percent"
        },
        "profile_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Hash"
        },
        "profile_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonProfileRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "retention_analysis_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retention Analysis Id"
        },
        "runs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Runs",
          "type": "array"
        },
        "selected_state_ids": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected State Ids"
        },
        "state_analysis_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Analysis Id"
        },
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "blocked",
            "queued",
            "running",
            "succeeded",
            "partial",
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "display_name"
      ],
      "title": "ComparisonCardResult",
      "type": "object"
    },
    "ComparisonProfileRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "ComparisonProfileRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "c2c_basis": {
      "anyOf": [
        {
          "enum": [
            "overall",
            "detrended",
            "assumed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "C2C Basis"
    },
    "cards": {
      "items": {
        "$ref": "#/$defs/ComparisonCardResult"
      },
      "title": "Cards",
      "type": "array"
    },
    "clone_operation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clone Operation Id"
    },
    "common_settings": {
      "additionalProperties": true,
      "title": "Common Settings",
      "type": "object"
    },
    "comparison_id": {
      "format": "uuid",
      "title": "Comparison Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "discard_requested": {
      "default": false,
      "title": "Discard Requested",
      "type": "boolean"
    },
    "experiment_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Experiment Id"
    },
    "job_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Id"
    },
    "lifecycle": {
      "enum": [
        "drafting",
        "running",
        "temporary",
        "saved",
        "discarded"
      ],
      "title": "Lifecycle",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "origin_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Origin Id"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "succeeded",
            "partial",
            "failed",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "snapshot": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "comparison_id",
    "version",
    "lifecycle",
    "common_settings",
    "cards",
    "created_at",
    "updated_at"
  ],
  "title": "ComparisonResult",
  "type": "object"
}
