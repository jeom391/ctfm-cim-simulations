{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "effects": {
            "properties": {
              "d2d": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "arrays": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "effects": {
            "properties": {
              "retention": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "years": {
            "const": [
              0
            ]
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "hardware": {
            "additionalProperties": false,
            "properties": {
              "adc_bits": {
                "const": null
              },
              "adc_order": {
                "const": null
              },
              "preset_id": {
                "const": null
              },
              "range_policy": {
                "const": null
              },
              "tile_size": {
                "enum": [
                  64,
                  128,
                  256
                ]
              }
            },
            "required": [
              "tile_size",
              "adc_bits",
              "adc_order",
              "range_policy",
              "preset_id"
            ],
            "type": "object"
          }
        }
      },
      "if": {
        "properties": {
          "effects": {
            "properties": {
              "adc": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "hardware": {
            "additionalProperties": false,
            "properties": {
              "adc_bits": {
                "enum": [
                  3,
                  4,
                  5,
                  6,
                  7,
                  8
                ]
              },
              "adc_order": {
                "enum": [
                  "subtract_then_adc",
                  "adc_then_subtract"
                ]
              },
              "preset_id": {
                "const": null
              },
              "range_policy": {
                "const": "validation_max_abs"
              },
              "tile_size": {
                "enum": [
                  64,
                  128,
                  256
                ]
              }
            },
            "required": [
              "tile_size",
              "adc_bits",
              "adc_order",
              "range_policy",
              "preset_id"
            ],
            "type": "object"
          }
        }
      }
    }
  ],
  "description": "Validated request shape; server must also enforce published profile/data/engine capabilities and run budget. No measured device fields may be overridden. v1.1.0 requests are not reinterpreted: tile_size is now explicit with the ADC off and adc_order is required, so a 1.1.0 request is rejected with an explicit migration error.",
  "properties": {
    "arrays": {
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
    },
    "checkpoint_id": {
      "format": "uuid",
      "type": [
        "string",
        "null"
      ]
    },
    "effects": {
      "additionalProperties": false,
      "properties": {
        "adc": {
          "type": "boolean"
        },
        "c2c": {
          "const": false
        },
        "d2d": {
          "type": "boolean"
        },
        "retention": {
          "type": "boolean"
        }
      },
      "required": [
        "d2d",
        "retention",
        "adc",
        "c2c"
      ],
      "type": "object"
    },
    "engines": {
      "additionalProperties": false,
      "properties": {
        "accuracy": {
          "enum": [
            "torch_reference",
            "aihwkit_ideal"
          ]
        },
        "ppa": {
          "const": "off"
        }
      },
      "required": [
        "accuracy",
        "ppa"
      ],
      "type": "object"
    },
    "hardware": {
      "additionalProperties": false,
      "properties": {
        "adc_bits": {
          "enum": [
            null,
            3,
            4,
            5,
            6,
            7,
            8
          ]
        },
        "adc_order": {
          "enum": [
            null,
            "subtract_then_adc",
            "adc_then_subtract"
          ]
        },
        "preset_id": {
          "const": null
        },
        "range_policy": {
          "enum": [
            null,
            "validation_max_abs"
          ]
        },
        "tile_size": {
          "enum": [
            64,
            128,
            256
          ]
        }
      },
      "required": [
        "tile_size",
        "adc_bits",
        "adc_order",
        "range_policy",
        "preset_id"
      ],
      "type": "object"
    },
    "mappings": {
      "items": {
        "enum": [
          "fixed_reference",
          "pair_search"
        ]
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "model_id": {
      "const": "mnist_mlp_v1"
    },
    "n_reprogram": {
      "const": 1
    },
    "pools": {
      "items": {
        "enum": [
          "combined",
          "ltp",
          "ltd",
          "common"
        ]
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "profile_refs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "years": {
      "contains": {
        "const": 0
      },
      "items": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "profile_refs",
    "model_id",
    "checkpoint_id",
    "pools",
    "mappings",
    "effects",
    "arrays",
    "n_reprogram",
    "years",
    "seed",
    "hardware",
    "engines"
  ],
  "title": "CTFM first-release experiment request v1.2.0",
  "type": "object"
}
